# Opsional: Pengiriman Kode Reset Kata Sandi via Gmail (100% Gratis)
# Aktifkan Verifikasi 2 Langkah di akun Google lalu buat Sandi Aplikasi (App Password).
# Jika file .env tidak dibuat, kode reset 6 digit tetap muncul di jendela terminal JALANKAN.bat.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Opsional: isi jika di-hosting di Vercel/cloud dengan database Turso (kosongkan jika lokal app.db)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
